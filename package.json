  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx index.ts",
    "build": "esbuild index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "create-sessions-table": "tsx scripts/create-sessions-table.ts",
    "setup-storage": "tsx scripts/setup-storage.ts",
    "setup-pending-deletions": "tsx scripts/setup-pending-deletions-table.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/memoizee": "^0.4.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.36.4",
    "drizzle-zod": "^0.5.1",
    "esbuild": "^0.24.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "marked": "^15.0.12",
    "memoizee": "^0.4.17",
    "memorystore": "^1.6.7",
    "node-cron": "^4.1.1",
    "nodemon": "^3.1.10",
    "openai": "^4.77.0",
    "openid-client": "^6.1.3",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.13.1",
    "puppeteer": "^23.10.4",
    "sharp": "^0.34.2",
    "stripe": "^17.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1",
    "zod-validation-error": "^3.4.0"
